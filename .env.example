# Copy to .env and adjust. Consumed by docker-compose.yml.
APP_PORT=8081
MONGO_PORT=27017

# MongoDB. MDB_USER/MDB_PASSWORD also seed the mongo container's root user,
# so changing them after the first run requires `docker compose down -v`.
MDB_HOST=mongo
MDB_USER=admin
MDB_PASSWORD=admin
MDB_PREFIX=maw_

ENVIRONEMENT=PREPROD_LAN
SOCKETIO_HOST=http://localhost
SOCKETIO_PORT=3008
